{
  "bodyHtml": "\n    <div id=\"root\"><div class=\"w-screen min-h-screen flex justify-center items-center\"><div class=\"w-screen min-h-screen flex justify-center items-center\"><div class=\"flex items-center justify-center min-h-screen bg-background p-6\"><div class=\"w-full max-w-lg bg-card rounded-2xl border p-8 shadow-lg\"><div class=\"mb-6 text-center\"><h3 class=\"text-xl font-semibold\">Text Shimmer Effect</h3><p class=\"text-muted-foreground text-sm\">Animated gradient text with automatic cycling</p></div><div class=\"flex items-center justify-center rounded-lg bg-muted/10 py-10\"><div style=\"opacity: 1; transform: none;\"><span class=\"relative inline-block bg-[length:250%_100%,auto] bg-clip-text text-transparent [--base-color:var(--muted-foreground)] [--shimmer-color:var(--foreground)] [background-repeat:no-repeat,padding-box] [--shimmer-bg:linear-gradient(90deg,transparent_calc(50%-var(--spread)),var(--shimmer-color),transparent_calc(50%+var(--spread)))] dark:[--base-color:var(--muted-foreground)] dark:[--shimmer-color:var(--foreground)]\" style=\"--spread: 40px; background-image: var(--shimmer-bg), linear-gradient(var(--base-color), var(--base-color)); background-position: 0% center; opacity: 1;\">Agent is thinking...</span></div></div></div></div></div></div></div>\n  <script>(()=>{const r=()=>requestAnimationFrame(()=>requestAnimationFrame(()=>parent.postMessage({type:\"21st-preview-ready\"},\"*\")));document.readyState===\"complete\"?r():addEventListener(\"load\",r,{once:true})})()</script><script data-21st-keys=\"1\">(()=>{\nif(parent===window)return\nconst q='[data-state=\"open\"],dialog[open]'\nconst open=()=>document.querySelectorAll(q).length\naddEventListener(\"keydown\",(e)=>{\nconst before=open()\nsetTimeout(()=>{\nif(e.defaultPrevented||open()<before)return\nconst t=(e.composedPath&&e.composedPath()[0])||e.target\nif(t&&(t.isContentEditable||/^(INPUT|TEXTAREA|SELECT)$/.test(t.nodeName)))return\nparent.postMessage({type:\"21st-preview-key\",key:e.key,code:e.code,altKey:e.altKey,ctrlKey:e.ctrlKey,metaKey:e.me",
  "shaders": [],
  "keyframes": []
}