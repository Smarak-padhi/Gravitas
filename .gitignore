# ──────────────────────────────────────────────────
# Gravitas — .gitignore
# ──────────────────────────────────────────────────

# Runtime evidence — NEVER commit execution artifacts
.gravitas/

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build outputs
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Environment / secrets — NEVER commit secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Editor artifacts
.DS_Store
.vscode/
*.swp
*.swo
*~

# OS artifacts
Thumbs.db
