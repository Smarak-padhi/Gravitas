# ──────────────────────────────────────────────────
# Gravitas — .gitignore
# ──────────────────────────────────────────────────

# Runtime evidence — NEVER commit execution artifacts
.gravitas/
codex-qualification.json
omniroute-qualification.json

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build outputs
dist/
build/
*.tsbuildinfo

# Test coverage and artifacts
coverage/
.nyc_output/
test-results/
tests/screenshots/

# Environment / secrets — NEVER commit secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Editor artifacts
.DS_Store
.vscode/
*.swp
*.swo
*~

# OS artifacts
Thumbs.db
