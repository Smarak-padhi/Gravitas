{
  "name": "gravitas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Gravitas — local-first multi-agent command center",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:harnesses": "vitest run packages/harnesses",
    "test:claude-integration": "vitest run packages/harnesses/src/claude-integration.test.ts",
    "demo:claude": "vitest run packages/harnesses/src/claude-integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
